{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The Selfward window: the splash page, and the app served by the local API",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:8100/*", "http://localhost:8100/*"]
  },
  "permissions": [
    "core:default",
    "opener:default"
  ]
}
